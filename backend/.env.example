# Backend configuration. Python reads process environment variables directly;
# this file documents them and is NOT loaded automatically. Never put secrets or
# real records here.

# Local SQLite demo database (default: backend/reunify_demo.sqlite3).
DATABASE_URL=sqlite:///reunify_demo.sqlite3

# Development-only demo authentication. This is NOT production security: it lets a
# visitor assume a fictional seeded identity to exercise role-based access.
# Demo auth only turns on when APP_ENV=development AND DEMO_AUTH_ENABLED=true.
APP_ENV=development
DEMO_AUTH_ENABLED=false

# Credentialed CORS origin for the local frontend (loopback only).
FRONTEND_ORIGIN=http://localhost:3000

# Where authorized, validated intake images are stored (gitignored; never public).
UPLOAD_DIR=uploads
